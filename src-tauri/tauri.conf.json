{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KReader",
  "version": "0.21.1",
  "identifier": "com.kreader.app",
  "build": {
    "beforeDevCommand": "vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "tsc && vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KReader",
        "width": 800,
        "height": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": []
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Karmine",
    "windows": {
      "nsis": {
        "languages": ["SpanishInternational", "English"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/512x512.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["cbz"],
        "mimeType": "application/x-cbz",
        "name": "Comic Book Zip",
        "description": "KReader CBZ Comic",
        "role": "Editor"
      },
      {
        "ext": ["cbr"],
        "mimeType": "application/x-cbr",
        "name": "Comic Book RAR",
        "description": "KReader CBR Comic",
        "role": "Editor"
      },
      {
        "ext": ["epub"],
        "mimeType": "application/epub+zip",
        "name": "EPUB Book",
        "description": "KReader EPUB E-book",
        "role": "Editor"
      },
      {
        "ext": ["pdf"],
        "mimeType": "application/pdf",
        "name": "PDF Document",
        "description": "KReader PDF Document",
        "role": "Viewer"
      },
      {
        "ext": ["zip"],
        "mimeType": "application/zip",
        "name": "ZIP Archive",
        "description": "KReader ZIP Image Archive",
        "role": "Viewer"
      },
      {
        "ext": ["rar"],
        "mimeType": "application/x-rar-compressed",
        "name": "RAR Archive",
        "description": "KReader RAR Image Archive",
        "role": "Viewer"
      }
    ]
  }
}